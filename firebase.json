{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "rezeptlogik-verden-factor",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/refresh-ramp-up", "function": "refreshRampUp", "region": "europe-west3" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
  // HINWEIS: "firestore"-Block bewusst entfernt (Schutzgelaender).
  // Das Projekt "hellofresh-de-problem-solve" wird von mehreren Apps geteilt.
  // Firestore-Rules gelten projektweit und duerfen aus diesem App-Repo NICHT
  // ausgerollt werden, weil sonst andere Apps im Shared-Projekt betroffen sind.
  // Regeln fuer die Default-DB nur ueber den sicheren Master-Prozess
  // (Console/REST bzw. dediziertes Master-Repo) aendern, nicht ueber dieses Repo.
}
