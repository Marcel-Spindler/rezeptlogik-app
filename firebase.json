{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "rezeptlogik-verden-factor",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/refresh-ramp-up", "function": "refreshRampUp" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
  // HINWEIS: "firestore"-Block bewusst entfernt (Schutzgelaender).
  // Das Projekt "hellofresh-de-problem-solve" wird von mehreren Apps geteilt
  // (u. a. Factory-Hub). Firestore-Rules gelten projektweit und wuerden sich
  // sonst gegenseitig ueberschreiben. Die Datei firestore.rules in diesem Repo
  // ist die zusammengefuehrte Referenzversion (Factory-Hub + Rezeptlogik) und
  // ist bereits live deployt. Aenderungen an Rules nur bewusst und manuell:
  //   1) "firestore"-Block hier temporaer wieder einfuegen
  //   2) firebase deploy --only firestore:rules --project hellofresh-de-problem-solve
  //   3) Block wieder entfernen
}
