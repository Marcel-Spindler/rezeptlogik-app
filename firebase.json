{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "rezeptlogik-verden-factor",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/refresh-ramp-up", "function": "refreshRampUp", "region": "europe-west3" },
      { "source": "/api/agent-run", "function": "agentRun", "region": "europe-west3" },
      { "source": "/api/agent-approve", "function": "agentApprove", "region": "europe-west3" },
      { "source": "/api/agent-apply", "function": "agentApply", "region": "europe-west3" },
      { "source": "/api/wms-plating", "function": "wmsPlating", "region": "europe-west3" },
      { "source": "/api/wms-plating-history", "function": "wmsPlatingHistory", "region": "europe-west3" },
      { "source": "/api/wms-sleeving", "function": "wmsSleeving", "region": "europe-west3" },
      { "source": "/api/wms-inbound", "function": "wmsInbound", "region": "europe-west3" },
      { "source": "/api/wms-staging", "function": "wmsStaging", "region": "europe-west3" },
      { "source": "/api/wms-debox", "function": "wmsDebox", "region": "europe-west3" },
      { "source": "/api/wms-postblast", "function": "wmsPostblast", "region": "europe-west3" },
      { "source": "/api/wms-workorders", "function": "wmsWorkorders", "region": "europe-west3" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
  // HINWEIS: "firestore"-Block bewusst entfernt (Schutzgelaender).
  // Das Projekt "hellofresh-de-problem-solve" wird von mehreren Apps geteilt.
  // Firestore-Rules gelten projektweit und duerfen aus diesem App-Repo NICHT
  // ausgerollt werden, weil sonst andere Apps im Shared-Projekt betroffen sind.
  // Regeln fuer die Default-DB nur ueber den sicheren Master-Prozess
  // (Console/REST bzw. dediziertes Master-Repo) aendern, nicht ueber dieses Repo.
}
