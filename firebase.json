{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "rezeptlogik-verden-factor",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/rack-boxfiles", "function": "rackBoxfiles", "region": "europe-west3" },
      { "source": "/api/rack-inputs", "function": "rackInputs", "region": "europe-west3" },
      { "source": "/api/refresh-ramp-up", "function": "refreshRampUp", "region": "europe-west3" },
      { "source": "/api/refresh-operational", "function": "refreshOperationalData", "region": "europe-west3" },
      { "source": "/api/agent-run", "function": "agentRun", "region": "europe-west3" },
      { "source": "/api/agent-approve", "function": "agentApprove", "region": "europe-west3" },
      { "source": "/api/agent-apply", "function": "agentApply", "region": "europe-west3" },
      { "source": "/api/wms-plating", "function": "wmsPlating", "region": "europe-west3" },
      { "source": "/api/wms-plating-history", "function": "wmsPlatingHistory", "region": "europe-west3" },
      { "source": "/api/wms-sleeving", "function": "wmsSleeving", "region": "europe-west3" },
      { "source": "/api/wms-inbound", "function": "wmsInbound", "region": "europe-west3" },
      { "source": "/api/wms-staging", "function": "wmsStaging", "region": "europe-west3" },
      { "source": "/api/wms-debox", "function": "wmsDebox", "region": "europe-west3" },
      { "source": "/api/wms-postblast", "function": "wmsPostblast", "region": "europe-west3" },
      { "source": "/api/wms-workorders", "function": "wmsWorkorders", "region": "europe-west3" },
      { "source": "/api/wms-wo-detail", "function": "wmsWoDetail", "region": "europe-west3" },
      { "source": "/api/wms-plating-holding", "function": "wmsPlatingHolding", "region": "europe-west3" },
      { "source": "/api/wms-breakdown", "function": "wmsBreakdown", "region": "europe-west3" },
      { "source": "/api/redzone-plating-status", "function": "redzoneStatus", "region": "europe-west3" },
      { "source": "/api/local-db/gemini-instruction", "function": "geminiInstruction", "region": "europe-west3" },
      { "source": "/api/local-db/gemini-instructions-batch", "function": "geminiInstructionsBatch", "region": "europe-west3" },
      { "source": "/api/local-db/gemini-planning-chat", "function": "geminiPlanningChat", "region": "europe-west3" },
      { "source": "/api/local-db/gemini-plating-chat", "function": "geminiPlatingChat", "region": "europe-west3" },
      { "source": "/api/local-db/generate-pdf", "function": "generatePdf", "region": "europe-west3" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
