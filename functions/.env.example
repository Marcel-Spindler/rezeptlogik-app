# --------------------------------------------------
# Planning OASE Agent - Functions ENV Vorlage
# Datei kopieren nach: functions/.env
# --------------------------------------------------

# Wichtig:
# - Hier nur Platzhalter eintragen.
# - Echte Werte gehoeren in functions/.env (lokal) bzw. in die produktive
#   Functions-Umgebung.

# Bestehend im Projekt (Ramp-Up Sync)
GSHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Agent Provider (du brauchst mindestens EINS von beiden)
# 1) Gemini
GEMINI_API_KEY=your-gemini-api-key

# 2) GitHub Models (optional als Alternative zu Gemini)
GITHUB_MODELS_API_KEY=your-github-models-api-key
# Optional, wenn du den Default-Endpunkt ueberschreiben willst
# GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com/chat/completions

# Pipeline Security
# Nur noetig, wenn Access Mode im Formular auf "token" steht.
# Bei role-based kannst du das leer lassen.
AGENT_PIPELINE_TOKEN=optional-token-if-needed

# Approval Freshness Guard (in Minuten)
# Apply nur mit frischer Freigabe (Default im Code: 120)
AGENT_APPROVAL_MAX_AGE_MINUTES=120

# Origin-Allowlist (Schutz B): zusaetzliche erlaubte Origins fuer die HTTP-
# Functions, kommagetrennt. Nur noetig, wenn die App unter einer Custom-Domain
# laeuft — die *.web.app / *.firebaseapp.com-Domains + localhost sind im Code
# schon drin. Beispiel:
# EXTRA_ALLOWED_ORIGINS=https://planer.hellofresh.de,https://verden-planer.hellofresh.de

# OCR fuer Bilddateien
# true = OCR aktiv (Vision API), false = OCR aus
AGENT_OCR_ENABLED=true

# ============================================================
# Backfill-Waechter (rtiBackfillWatch / rtiMarkDone)
# Setup-Anleitung: siehe BACKFILL_WAECHTER_SETUP.md (Repo-Wurzel)
# ============================================================
# Slack-URL fuer die 10-Minuten-Meldung. Beide Formen gehen:
#   Weg A (Workflow Builder):  https://hooks.slack.com/triggers/...
#   Weg B (Incoming Webhook):  https://hooks.slack.com/services/...
# Ohne diese Variable laeuft der Watcher, postet aber nichts (nur Log).
SLACK_WEBHOOK_URL=https://hooks.slack.com/triggers/XXX/YYY/ZZZ
# Optional — Defaults passen fuer dieses Projekt:
# RTI_SHEET_ID=1-brEn6eKSMFDTubokqA7brq_BzjKP0RpmGw4A1RPspw
# RTI_SHEET_TAB=RTI
# RTI_STALE_MIN=30
#
# Planned Target / Actuals selbst in den RTI-Sheet-Kopf schreiben, wenn sie
# fehlen (Ziel = Forecast/weekRecipes, Ist = Redzone-Plating-Output). "0" = aus.
# RTI_AUTOFILL_HEADER=1
# Wiege-Fenster (Europe/Berlin): ausserhalb kein Auto-Ausfuellen + kein Nag.
# Ab Spaetschicht (Mo–Fr bis 23 Uhr) einfach RTI_PLATING_END_HOUR=23 setzen.
# RTI_PLATING_START_HOUR=6
# RTI_PLATING_END_HOUR=15
# REDZONE_STATUS_URL=https://rezeptlogik-verden-factor.web.app/api/redzone-plating-status
#
# rtiMarkDone (Waechter schreibt "done" in Spalte J) und das Kopf-Ausfuellen
# brauchen KEINE eigene Variable, aber der Service-Account aus
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64 muss BEARBEITER des RTI-Sheets sein.

# ============================================================
# WMS Daten Caching (Snowflake Key-Pair Auth, live in Cloud Functions)
# ============================================================
# Die wms*-Endpoints (wmsPlating, wmsWorkorders, wmsStaging, ...) fragen
# Snowflake bei JEDEM Aufruf LIVE ab (JWT Key-Pair Auth, kein SSO/Browser
# nötig, läuft headless). Fallback bei Fehler: Firestore Collection
# 'wmsCache'. Setup-Anleitung (Key generieren + Snowflake-User anlegen):
# siehe docs/SNOWFLAKE_KEYPAIR_SETUP.md
#
# Erforderlich:
SNOWFLAKE_ACCOUNT=your-snowflake-account-locator
SNOWFLAKE_USER=your-snowflake-service-user
SNOWFLAKE_PRIVATE_KEY=base64-pkcs8-private-key-body-ohne-header-footer

# Optional (Defaults im Code passen für dieses Projekt bereits):
# SNOWFLAKE_ROLE=US_OPS_ANALYTICS_USER
# SNOWFLAKE_WAREHOUSE=US_OPS_ANALYTICS
# SNOWFLAKE_DATABASE=US_OPS_ANALYTICS
# SNOWFLAKE_SCHEMA=HIGHJUMP
