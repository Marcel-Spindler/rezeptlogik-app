{
  "name": "rezeptlogik-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview --port 5173",
    "import:local": "tsx scripts/import-local.ts",
    "import:gsheet": "tsx scripts/import-gsheet.ts",
    "push:wms:input": "tsx scripts/push-wms-transaction-log.ts",
    "sync:wms:kw-tabs": "tsx scripts/sync-wms-kw-tabs.ts",
    "rackfile:plan": "tsx scripts/rackfile-tool.ts plan",
    "rackfile:generate": "tsx scripts/rackfile-tool.ts generate",
    "push:firestore": "tsx scripts/push-firestore.ts",
    "sync:factor:forecast": "tsx scripts/sync-factor-forecast.ts",
    "sync:running:forecast": "tsx scripts/sync-running-forecast.ts",
    "sync:gsheet:registry": "tsx scripts/refresh-gsheet-sources.ts",
    "test:smoke:oase": "playwright test Test/planning-oase-smoke.spec.ts --browser=chromium",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "wms:sync": "tsx scripts/sync-wms-cache.ts",
    "wms:push": "tsx scripts/push-wms-firestore.ts",
    "wms:server": "tsx scripts/wms-local-server.ts",
    "sync:fulfillment:report": "tsx scripts/sync-fulfillment-report.ts",
    "sync:all": "npm run sync:factor:forecast && npm run import:gsheet && npm run sync:gsheet:registry && npm run sync:fulfillment:report",
    "sync:all:deploy": "npm run sync:all && npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "firebase": "^11.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.0.1",
    "googleapis": "^144.0.0",
    "papaparse": "^5.4.1",
    "postcss": "^8.4.49",
    "snowflake-sdk": "^2.4.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^5.4.10"
  }
}
