{
  "name": "rezeptlogik-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "db:build": "node scripts/local-db.mjs",
    "db:translate-instructions": "node scripts/translate-instructions.mjs",
    "db:serve": "node scripts/local-db-server.mjs",
    "dev:local": "npm run db:build && node scripts/start-local.mjs",
    "dev": "concurrently -n vite,csv -c cyan,green \"vite\" \"tsx scripts/import-sub-recipes.ts --watch\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview --port 5173",
    "discover:sheets": "tsx scripts/discover-sheets.ts",
    "import:local": "tsx scripts/import-local.ts",
    "watch:operational": "tsx scripts/watch-operational.ts",
    "import:gsheet": "tsx scripts/import-gsheet.ts",
    "import:meal-database": "tsx scripts/import-meal-database.ts",
    "import:sub-recipes": "tsx scripts/import-sub-recipes.ts",
    "import:pfei": "tsx scripts/import-pfei.ts",
    "import:rampup": "tsx scripts/import-rampup.ts",
    "push:firestore": "tsx scripts/push-firestore.ts",
    "ket:publish": "tsx scripts/ket-publish.ts",
    "rackfile:plan": "tsx scripts/rackfile-tool.ts plan",
    "rackfile:generate": "tsx scripts/rackfile-tool.ts generate",
    "test:smoke:oase": "playwright test Test/planning-oase-smoke.spec.ts --browser=chromium",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting",
    "deploy:functions": "cd functions && npm install && npx firebase-tools deploy --only functions",
    "deploy:all": "npm run build && npx firebase-tools deploy --only hosting,functions",
    "import:weekly-planning": "tsx scripts/read-weekly-planning.ts",
    "import:kitchen-bible": "tsx scripts/import-kitchen-bible.ts",
    "import:planning-calendar": "tsx scripts/import-planning-calendar.ts",
    "import:weight-tracking": "tsx scripts/import-weight-tracking.ts",
    "wms:server": "tsx scripts/wms-local-server.ts",
    "wms:sync-cache": "tsx scripts/sync-wms-cache.ts",
    "dump:kpl": "tsx scripts/dump-gsheet.ts 13lZfV1HAcVuOAxd9-xHCEsxO0wHmPnJNl9NuoURpM6U",
    "sync:all": "npm run import:gsheet && npm run import:local && npm run import:rampup && npm run import:weekly-planning && npm run push:firestore",
    "sync:all:deploy": "npm run sync:all && npm run build && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@tanstack/react-virtual": "^3.14.10",
    "dotenv": "^17.4.2",
    "firebase": "11.0.2",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.10.0",
    "googleapis": "^144.0.0",
    "papaparse": "^5.4.1",
    "postcss": "^8.4.49",
    "rollup": "^4.21.3",
    "snowflake-sdk": "^2.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.7"
  }
}
