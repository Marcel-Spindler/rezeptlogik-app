# Firebase Web-App config (öffentlich, kein Secret)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Datenquelle: 'local' (public/data/*.json) oder 'firestore'
VITE_DATA_SOURCE=local

# --- Server-only (für scripts/) ---
# Sheet-Reader (Service Account, nur Lesen)
# Von den Import-Skripten (Google Sheets/Drive) genutzt.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Firestore-Writer (Service Account, Schreiben in apps/rezeptlogik/*)
# Wenn gesetzt, hat diese Variable Priorität für Write-Skripte.
FIRESTORE_WRITER_CREDENTIALS=

# Optional: Wenn weder FIRESTORE_WRITER_CREDENTIALS noch
# GOOGLE_APPLICATION_CREDENTIALS gesetzt sind, lokale gcloud-ADC nutzen.
# 1 = aktiv, 0 = aus
FIRESTORE_USE_GCLOUD_ADC=1

# Sicherheits-Guard: bekannte Reader-Accounts duerfen nicht als Writer genutzt werden.
# Nur fuer Notfaelle auf 1 setzen.
FIRESTORE_ALLOW_READER_AS_WRITER=0

# GSheet ID Ramp-Up Plan primär (aus URL: docs.google.com/spreadsheets/d/<ID>/edit)
GSHEET_ID=
# Weitere Ramp-Up Sheets (kommagetrennt — gleiches Format wie GSHEET_ID)
GSHEET_IDS=
# PFEI (Equipment- & Batch-Daten)
PFEI_GSHEET_ID=1cQtoL4aYHfc_44mfQQty8-EFKPZoYPLBQ2ojmO8hgzg
# Open Shelf Life / MLOR
OPEN_SHELF_GSHEET_ID=1dET5WmRKYRhmzEmhlBv1ZpRo5huWgNLfIY6uaLpCrcc
# Cook Schedules VF
SHEET_COOK_SCHEDULES=1jUN_IxCT4nodV21gwb1N_RKdxDrVilH00rC8khBEll8
# Operational Sheets
SHEET_WOCHENSTART=1YscgiuKYVI2pGcMJ3RcJwWGQEkG46RnVnji8q8a4AeE
SHEET_PRINT_ORDERS=1fpEHBWmd_zk74wbu78unPoTV_u860smNlxTuioEdq-4
SHEET_KITCHEN_PRIORITY=13lZfV1HAcVuOAxd9-xHCEsxO0wHmPnJNl9NuoURpM6U
SHEET_FERTIGSTELLUNG=1BEaL3ggpHGS5TbncUM5OLMUbVgRx-ADKOtRr_Sc8xXY
# Planning Calendar (Deadlines & Eskalationskontakte, Tab "Planning Calendar" im F_VE Production Plan Sheet)
SHEET_PLANNING_CALENDAR=1zaQjWKlNN4JNCMnE-lrdgf7iNgabfl9HGq5vdOyKedI
# Weight Tracking (Kitchen) | F_ EU -- manuelles Wiege-Log, Yield-Ist/Ziel-Vergleich
SHEET_WEIGHT_TRACKING=1-brEn6eKSMFDTubokqA7brq_BzjKP0RpmGw4A1RPspw

# KI-Planungsassistent + WO Instruction Bot (scripts/local-db-server.mjs, nur lokaler Server)
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# KET-WO-Ausdruck nach Drive (scripts/ket-publish.ts — npm run ket:publish)
# ============================================================
# Lokaler Pfad des gemounteten Google-Drive-für-Desktop-Ordners; darunter legt das
# Skript "W<nn>-Gemini/<Protein|Veggie>/<Tag>/WO_*.pdf" an. Drive synct hoch.
KET_DRIVE_ROOT=G:\Meine Ablage\Recipe Bible 2.0
# Fallback via Drive-API — funktioniert NUR mit einem Shared Drive (in einen
# "Meine Ablage"-Ordner kann ein Service Account nicht schreiben: kein SA-
# Speicherkontingent). Prüfen: npm run ket:publish -- --check-drive
#   KET_DRIVE_API=1
#   KET_DRIVE_FOLDER_ID=<Shared-Drive-/-Ordner-ID>
#   KET_DRIVE_CREDENTIALS=./secrets/…json   (sonst FIRESTORE_WRITER_CREDENTIALS)

# Snowflake WMS Live (nur serverseitig / Firebase Functions)
# ============================================================
# WORKFLOW:
# 1. LOKAL: npx ts-node scripts/sync-wms-cache.ts
#    -> Fragt Snowflake via SSO ab, speichert Daten in public/data/wms-cache.json
# 2. CLOUD: Cloud Functions laden Daten aus Firestore oder Fallback public/data/
#    -> Kein Snowflake-Zugriff nötig (kein Service Account erforderlich!)

SNOWFLAKE_ACCOUNT=XG02811-OO69432
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=US_OPS_ANALYTICS_USER
SNOWFLAKE_WAREHOUSE=US_OPS_ANALYTICS
SNOWFLAKE_DATABASE=US_OPS_ANALYTICS
SNOWFLAKE_SCHEMA=HIGHJUMP
SNOWFLAKE_WH_ID=VF
