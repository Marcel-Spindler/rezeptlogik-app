# Firebase Web-App config (öffentlich, kein Secret)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Datenquelle: 'local' (public/data/*.json) oder 'firestore'
VITE_DATA_SOURCE=local

# --- Server-only (für scripts/) ---
# Pfad zur Service-Account JSON (NIE committen!)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# GSheet ID (aus URL: docs.google.com/spreadsheets/d/<ID>/edit)
GSHEET_ID=

# Snowflake WMS Live (nur serverseitig / Firebase Functions)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=US_OPS_ANALYTICS_USER
SNOWFLAKE_WAREHOUSE=US_OPS_ANALYTICS
SNOWFLAKE_DATABASE=US_OPS_ANALYTICS
SNOWFLAKE_SCHEMA=HIGHJUMP
SNOWFLAKE_WH_ID=VF
